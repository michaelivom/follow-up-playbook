<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Showroom Lead Follow-up System</title>
  <style>
    :root {
      --bg: #f7f4ef;
      --card: #ffffff;
      --ink: #24211d;
      --muted: #6f675f;
      --line: #e3ddd4;
      --accent: #8d6e5a;
      --accent-dark: #60483a;
      --soft: #eee7de;
      --success: #55745b;
      --warning: #b1823b;
      --danger: #9b4b43;
      --shadow: 0 14px 35px rgba(40, 32, 24, .08);
      --radius: 22px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: linear-gradient(135deg, #f7f4ef 0%, #eee7de 100%);
      color: var(--ink);
      line-height: 1.55;
    }

    header {
      padding: 56px 24px 32px;
      max-width: 1180px;
      margin: 0 auto;
    }

    .hero {
      background: rgba(255,255,255,.72);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      border-radius: 32px;
      padding: 42px;
    }

    .eyebrow {
      text-transform: uppercase;
      letter-spacing: .13em;
      font-size: 12px;
      color: var(--accent-dark);
      font-weight: 700;
      margin-bottom: 12px;
    }

    h1 {
      font-size: clamp(34px, 5vw, 64px);
      line-height: 1.03;
      margin: 0 0 18px;
      letter-spacing: -.04em;
    }

    .hero p {
      max-width: 820px;
      color: var(--muted);
      font-size: 18px;
      margin: 0;
    }

    nav {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(14px);
      background: rgba(247,244,239,.78);
      border-bottom: 1px solid var(--line);
    }

    .nav-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 12px 24px;
    }

    .nav-btn, button {
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      border-radius: 999px;
      padding: 10px 16px;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: .2s ease;
    }

    .nav-btn:hover, button:hover {
      transform: translateY(-1px);
      border-color: var(--accent);
    }

    .nav-btn.active, button.active {
      background: var(--accent-dark);
      color: white;
      border-color: var(--accent-dark);
    }

    main {
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px;
    }

    section {
      margin: 28px 0;
      scroll-margin-top: 86px;
    }

    .section-title {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 16px;
    }

    h2 {
      font-size: clamp(26px, 3vw, 40px);
      margin: 0;
      letter-spacing: -.025em;
    }

    h3 {
      margin: 0 0 10px;
      font-size: 20px;
    }

    .grid {
      display: grid;
      gap: 16px;
    }

    .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .card {
      background: rgba(255,255,255,.83);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px;
      box-shadow: var(--shadow);
    }

    .small {
      color: var(--muted);
      font-size: 14px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      background: var(--soft);
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 800;
      color: var(--accent-dark);
      margin-bottom: 12px;
    }

    .timeline {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .step {
      position: relative;
      min-height: 250px;
    }

    .step-number {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--accent-dark);
      color: white;
      font-weight: 900;
      margin-bottom: 14px;
    }

    .lead-selector {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
    }

    .template-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
    }

    .template-box {
      background: #fbfaf7;
      border: 1px dashed #cdbead;
      border-radius: 18px;
      padding: 18px;
      white-space: pre-wrap;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      color: #332d27;
      min-height: 310px;
    }

    .meta {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 14px;
    }

    .meta div {
      background: var(--soft);
      border-radius: 16px;
      padding: 12px;
      font-size: 13px;
    }

    .status-hot { border-top: 5px solid var(--danger); }
    .status-warm { border-top: 5px solid var(--warning); }
    .status-cold { border-top: 5px solid var(--success); }

    .dos { border-left: 6px solid var(--success); }
    .donts { border-left: 6px solid var(--danger); }

    ul {
      padding-left: 20px;
      margin: 8px 0 0;
    }

    li { margin: 8px 0; }

    .copy-note {
      margin-top: 10px;
      font-size: 13px;
      color: var(--success);
      display: none;
    }

    .copy-note.visible { display: block; }

    .footer {
      color: var(--muted);
      text-align: center;
      padding: 36px 16px 54px;
    }

    @media (max-width: 900px) {
      .grid-2, .grid-3, .grid-4, .timeline, .meta {
        grid-template-columns: 1fr;
      }
      .hero { padding: 28px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="hero">
      <div class="eyebrow">Retail Follow-up System · Showroom Leads</div>
      <h1>Adaptive Lead Journey & Communication Playbook</h1>
      <p>
        A standardized but human follow-up system for affordable-premium showroom sales:
        personal, calm, consultative, and conversion-oriented without feeling pushy.
      </p>
    </div>
  </header>

  <nav>
    <div class="nav-inner">
      <a class="nav-btn active" href="#vision">Target Picture</a>
      <a class="nav-btn" href="#journey">Lead Journey</a>
      <a class="nav-btn" href="#templates">Templates</a>
      <a class="nav-btn" href="#success">Success Factors</a>
      <a class="nav-btn" href="#avoid">What to Avoid</a>
    </div>
  </nav>

  <main>
    <section id="vision">
      <div class="section-title">
        <h2>Target Picture</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <span class="pill">1 · Advisory Continuity</span>
          <h3>Continue the showroom consultation</h3>
          <p class="small">The follow-up should feel like the natural next step after the visit: personal, useful, and directly connected to what was discussed in the showroom.</p>
        </div>
        <div class="card">
          <span class="pill">2 · Decision Support</span>
          <h3>Help the customer decide</h3>
          <p class="small">The goal is not to chase leads. It is to reduce uncertainty around configuration, fabric, size, use case, delivery, and value.</p>
        </div>
        <div class="card">
          <span class="pill">3 · Consistent Performance</span>
          <h3>Standardize the system, not the human</h3>
          <p class="small">Timing, structure, CRM logic, and core messages are standardized. Personal references and recommendations stay individual.</p>
        </div>
      </div>
    </section>

    <section id="journey">
      <div class="section-title">
        <h2>Lead Journey & Communication Flow</h2>
      </div>

      <div class="lead-selector">
        <button class="active" onclick="setLeadType('hot', this)">Hot Lead</button>
        <button onclick="setLeadType('warm', this)">Warm Lead</button>
        <button onclick="setLeadType('cold', this)">Cold / Inspiration Lead</button>
      </div>

      <div id="leadDescription" class="card status-hot" style="margin-bottom:16px;"></div>

      <div class="timeline" id="journeyCards"></div>
    </section>

    <section id="templates">
      <div class="section-title">
        <h2>Templates by Step & Channel</h2>
      </div>

      <div class="card">
        <div class="template-toolbar">
          <button class="active" onclick="setStep(1, this)">Step 1</button>
          <button onclick="setStep(2, this)">Step 2</button>
          <button onclick="setStep(3, this)">Step 3</button>
          <button onclick="setStep(4, this)">Step 4</button>
          <button class="active" onclick="setChannel('email', this)">Email</button>
          <button onclick="setChannel('call', this)">Call Script</button>
          <button onclick="setChannel('whatsapp', this)">WhatsApp</button>
        </div>

        <div class="meta" id="templateMeta"></div>
        <div id="templateBox" class="template-box"></div>
        <button onclick="copyTemplate()">Copy template</button>
        <div id="copyNote" class="copy-note">Template copied.</div>
      </div>
    </section>

    <section id="success">
      <div class="section-title">
        <h2>Success Factors</h2>
      </div>
      <div class="grid grid-2">
        <div class="card dos">
          <h3>Operational success factors</h3>
          <ul>
            <li><strong>CRM discipline:</strong> every visit gets a lead status: Hot, Warm, or Cold.</li>
            <li><strong>24h first follow-up:</strong> no showroom visit should remain without a structured first message.</li>
            <li><strong>Personal reference:</strong> every message should include one real detail from the consultation.</li>
            <li><strong>Channel permission:</strong> WhatsApp only after explicit customer consent.</li>
            <li><strong>Advisor ownership:</strong> automation should create tasks and reminders, not replace the human relationship.</li>
          </ul>
        </div>
        <div class="card dos">
          <h3>Quality success factors</h3>
          <ul>
            <li><strong>One clear next step:</strong> each message should guide the customer gently.</li>
            <li><strong>Visual support:</strong> configuration links, sketches, photos, or fabric references whenever relevant.</li>
            <li><strong>Helpful, not needy:</strong> the tone should be calm, competent, and consultative.</li>
            <li><strong>Objection handling:</strong> address uncertainty around size, fabric, layout, delivery, and price early.</li>
            <li><strong>Review loop:</strong> sample 5 follow-ups per advisor per month and coach quality.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="avoid">
      <div class="section-title">
        <h2>What to Avoid</h2>
      </div>
      <div class="grid grid-3">
        <div class="card donts">
          <h3>Over-automation</h3>
          <p class="small">Avoid robotic sequences that ignore the customer’s showroom conversation, readiness, and personal context.</p>
        </div>
        <div class="card donts">
          <h3>Pushy urgency</h3>
          <p class="small">Affordable-premium sofas are considered purchases. Pressure can reduce trust and damage the showroom experience.</p>
        </div>
        <div class="card donts">
          <h3>Channel misuse</h3>
          <p class="small">Do not use WhatsApp for long explanations, technical details, or repeated reminders. Keep it short and contextual.</p>
        </div>
        <div class="card donts">
          <h3>Generic templates</h3>
          <p class="small">A template without a personal line feels like marketing, not advisory support.</p>
        </div>
        <div class="card donts">
          <h3>Weak handovers</h3>
          <p class="small">If the showroom notes are poor, the follow-up will be poor. Capture configuration, needs, concerns, and next step.</p>
        </div>
        <div class="card donts">
          <h3>No measurement</h3>
          <p class="small">Without response rate, follow-up rate, timing, and close rate, the system cannot improve.</p>
        </div>
      </div>
    </section>
  </main>

  <div class="footer">
    Built as a practical operating playbook for showroom teams using HubSpot.
  </div>

  <script>
    const journeyData = {
      hot: {
        className: "status-hot",
        title: "Hot Lead",
        text: "Concrete configuration, price discussed, strong buying signals. Use momentum, reduce final friction, and offer a calm decision path.",
        steps: [
          ["Step 1 · within 24h", "Email", "Send summary, configuration, personal recommendation, and clear next step."],
          ["Step 2 · day 2–3", "Call + WhatsApp", "Call to clarify final questions. If no answer, send a short WhatsApp with context."],
          ["Step 3 · day 5–7", "Email + optional WhatsApp", "Handle objections and reinforce the best-fit recommendation."],
          ["Step 4 · day 10–14", "Call or WhatsApp", "Gentle close-the-loop message. Ask whether the project is still active."]
        ]
      },
      warm: {
        className: "status-warm",
        title: "Warm Lead",
        text: "Clear interest, but still comparing, discussing internally, or unsure about configuration, fabric, size, or timing.",
        steps: [
          ["Step 1 · within 24h", "Email", "Send summary and 1–2 recommended options."],
          ["Step 2 · day 3–4", "WhatsApp or Email", "Low-friction check-in with one helpful question."],
          ["Step 3 · day 6–8", "Email", "Provide guidance around decision criteria and common uncertainties."],
          ["Step 4 · day 12–16", "WhatsApp or Email", "Re-open the conversation calmly and offer support."]
        ]
      },
      cold: {
        className: "status-cold",
        title: "Cold / Inspiration Lead",
        text: "Early-stage visitor, still collecting ideas, no clear configuration or buying timeline. Stay helpful and avoid pressure.",
        steps: [
          ["Step 1 · within 24h", "Email", "Thank them, recap inspiration points, and share useful links or examples."],
          ["Step 2 · day 4–6", "Email", "Send inspiration, modularity benefits, and fabric/use-case guidance."],
          ["Step 3 · day 9–12", "Email", "Invite them to clarify layout, measurements, or fabric direction."],
          ["Step 4 · day 18–24", "Email", "Gentle nurture message. Keep door open without sales pressure."]
        ]
      }
    };

    const templates = {
      1: {
        email: {
          goal: "Create continuity after the showroom visit.",
          timing: "Within 24 hours",
          use: "All lead types",
          text: `Subject: Your sofa ideas from our showroom visit

Hi [First Name],

Thank you for visiting us in the showroom. It was lovely to understand a bit more about your living space and what you are looking for in a sofa.

As discussed, I have summarized the main points below:

• Preferred setup: [configuration / layout]
• Fabric direction: [fabric / color]
• Key needs: [family use / guests / relaxing / flexibility / washable covers]
• Important note: [personal detail from the consultation]

Based on this, my recommendation would be [short recommendation + reason].

You can find the configuration here:
[configuration link]

Take your time to review it. If you have questions about size, fabric, or layout, I am happy to help you refine it.

Warm regards,
[Advisor Name]`
        },
        call: {
          goal: "Usually not the primary Step 1 channel unless the lead is very hot.",
          timing: "Same or next day for high-intent customers",
          use: "Hot leads only",
          text: `Opening:
Hi [First Name], this is [Advisor Name] from Livom. I hope this is still a good moment.

Reason:
I wanted to briefly follow up on your showroom visit and make sure the configuration I sent you matches what we discussed.

Consultative question:
After having had a little time to think about it, does the setup still feel right for your room?

Clarify:
Is there anything you are unsure about — size, fabric, layout, price, or timing?

Next step:
I can either adjust the configuration for you or send over the final version again with my recommendation.`
        },
        whatsapp: {
          goal: "Short personal nudge after email, only with permission.",
          timing: "After the email, if agreed in store",
          use: "Hot / Warm leads",
          text: `Hi [First Name], this is [Advisor Name] from Livom.

I just sent you the sofa configuration we discussed in the showroom. I also added a short summary so it is easier to review.

Happy to adjust anything if you notice that size, fabric, or layout should be refined.`
        }
      },
      2: {
        email: {
          goal: "Guide the customer based on buying readiness.",
          timing: "Day 2–6 depending on lead status",
          use: "Warm / Cold leads, or Hot if call was not possible",
          text: `Subject: A thought on your sofa configuration

Hi [First Name],

I had another look at your configuration and wanted to share one thought that might help with the decision.

Because you mentioned [specific need], I would keep the focus on [recommendation]. This gives you [benefit: flexibility / comfort / room balance / easy care].

If you are still comparing options, the most important decision points are usually:

1. Does the size work naturally in the room?
2. Does the fabric fit your everyday use?
3. Does the setup give you enough flexibility for the next few years?

My honest recommendation would be:
[advisor recommendation]

Would you like me to prepare an alternative version as a comparison?

Warm regards,
[Advisor Name]`
        },
        call: {
          goal: "Resolve open questions and keep momentum.",
          timing: "Day 2–3 for Hot leads",
          use: "Hot leads",
          text: `Opening:
Hi [First Name], this is [Advisor Name] from Livom. I wanted to briefly check in because your configuration was already quite concrete.

Question:
Have you had a chance to look at the setup?

Listen for:
• uncertainty about size
• fabric doubts
• partner approval
• delivery timing
• price/value concern

Response:
That makes sense. Based on what you told me in the showroom, I would recommend [recommendation] because [reason].

Close:
What would be most helpful now: a small adjustment, a second option, or a final confirmation of the setup?`
        },
        whatsapp: {
          goal: "Low-friction check-in.",
          timing: "Day 2–4",
          use: "Hot / Warm leads",
          text: `Hi [First Name], I hope you had a chance to look at the configuration.

One question from my side: does the setup still feel right for your room, or should I prepare a smaller/larger alternative for comparison?`
        }
      },
      3: {
        email: {
          goal: "Handle objections and support decision-making.",
          timing: "Day 5–8",
          use: "Hot / Warm leads",
          text: `Subject: A few points that may help with your decision

Hi [First Name],

I know choosing a sofa is not only about the look. It also has to work for your everyday life.

Based on our conversation, the key questions seem to be:

• Will the size work in your room?
• Is the fabric practical enough for your use case?
• Does the configuration give you enough flexibility long term?

For your situation, I would still recommend [configuration/fabric] because [reason].

A helpful way to think about it:
The sofa should not only fit your current room. It should also be flexible enough if your needs change over time.

If you like, I can send you a final version with [alternative / fabric comparison / layout adjustment].

Warm regards,
[Advisor Name]`
        },
        call: {
          goal: "Decision coaching, not pressure.",
          timing: "Day 5–7 for Hot leads with no response",
          use: "Hot leads or high basket value",
          text: `Opening:
Hi [First Name], I wanted to check in briefly and see whether there is anything still open regarding your sofa decision.

Diagnostic question:
What is currently the biggest question mark for you?

If price:
I understand. With Livom, the value is mainly in the modularity, washable covers, and long-term flexibility. The idea is not to replace the sofa quickly, but to adapt it over time.

If fabric:
That is an important decision. Based on your use case, I would recommend [fabric] because [reason].

If layout:
We can adjust the setup before you decide. I can prepare a comparison if that helps.

Close:
What would help you feel confident about the next step?`
        },
        whatsapp: {
          goal: "Short objection prompt.",
          timing: "Day 5–8",
          use: "Hot / Warm leads",
          text: `Hi [First Name], just checking in briefly.

Is there anything still unclear about the configuration — for example size, fabric, or layout? I am happy to help you refine it before you decide.`
        }
      },
      4: {
        email: {
          goal: "Close the loop gracefully.",
          timing: "Day 10–24 depending on lead status",
          use: "All lead types",
          text: `Subject: Should I keep your sofa project open?

Hi [First Name],

I wanted to gently check in once more regarding your sofa configuration.

If the topic is still relevant, I am happy to help you with the next step — whether that means adjusting the layout, comparing fabrics, or finalizing the setup.

If the timing is not right at the moment, that is completely fine as well.

Should I keep the configuration open for you?

Warm regards,
[Advisor Name]`
        },
        call: {
          goal: "Final high-intent reactivation.",
          timing: "Day 10–14",
          use: "Hot leads only",
          text: `Opening:
Hi [First Name], this is [Advisor Name] from Livom. I wanted to briefly close the loop on your sofa project.

Question:
Is the sofa still something you are actively considering, or has the timing changed?

If active:
Great. What would be the one thing we should clarify next?

If timing changed:
No problem at all. Would it be helpful if I keep the configuration noted for later?

Close:
I will update this accordingly and remain available if you want to continue.`
        },
        whatsapp: {
          goal: "Soft re-engagement.",
          timing: "Day 10–16 for Hot/Warm, later for Cold only if appropriate",
          use: "Hot / Warm leads with consent",
          text: `Hi [First Name], I just wanted to check whether your sofa project is still active.

If yes, I am happy to help with the next step. If the timing has changed, no problem at all.`
        }
      }
    };

    let currentLead = "hot";
    let currentStep = 1;
    let currentChannel = "email";

    function setLeadType(type, btn) {
      currentLead = type;
      document.querySelectorAll(".lead-selector button").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderJourney();
    }

    function renderJourney() {
      const data = journeyData[currentLead];
      const desc = document.getElementById("leadDescription");
      desc.className = "card " + data.className;
      desc.innerHTML = `<span class="pill">${data.title}</span><h3>${data.title}</h3><p class="small">${data.text}</p>`;

      const container = document.getElementById("journeyCards");
      container.innerHTML = data.steps.map((s, i) => `
        <div class="card step">
          <div class="step-number">${i + 1}</div>
          <h3>${s[0]}</h3>
          <p><strong>Recommended channel:</strong> ${s[1]}</p>
          <p class="small">${s[2]}</p>
        </div>
      `).join("");
    }

    function setStep(step, btn) {
      currentStep = step;
      const buttons = document.querySelectorAll(".template-toolbar button:nth-child(-n+4)");
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderTemplate();
    }

    function setChannel(channel, btn) {
      currentChannel = channel;
      const buttons = document.querySelectorAll(".template-toolbar button:nth-child(n+5)");
      buttons.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderTemplate();
    }

    function renderTemplate() {
      const item = templates[currentStep][currentChannel];
      document.getElementById("templateMeta").innerHTML = `
        <div><strong>Goal</strong><br>${item.goal}</div>
        <div><strong>Timing</strong><br>${item.timing}</div>
        <div><strong>Best used for</strong><br>${item.use}</div>
      `;
      document.getElementById("templateBox").textContent = item.text;
    }

    function copyTemplate() {
      const text = document.getElementById("templateBox").textContent;
      navigator.clipboard.writeText(text).then(() => {
        const note = document.getElementById("copyNote");
        note.classList.add("visible");
        setTimeout(() => note.classList.remove("visible"), 1600);
      });
    }

    document.querySelectorAll("nav a").forEach(a => {
      a.addEventListener("click", () => {
        document.querySelectorAll("nav a").forEach(x => x.classList.remove("active"));
        a.classList.add("active");
      });
    });

    renderJourney();
    renderTemplate();
  </script>
</body>
</html>
